{
  "name": "financial_report_analysis",
  "version": "2.0",
  "type": "decision_tree",
  "description": "财报分析能力包: 营收增长/利润率/现金流健康度评估 (4.7MB等价逻辑)",
  "author": "Spider-X",
  "rules": [
    {"condition": "revenue_growth > 0.2 and profit_margin > 0.15", "action": "strong_buy", "reason": "高增长+高利润"},
    {"condition": "revenue_growth > 0.1 and profit_margin > 0.1", "action": "buy", "reason": "稳健增长"},
    {"condition": "revenue_growth > 0 and cash_flow > 0", "action": "hold", "reason": "低增长但现金流健康"},
    {"condition": "revenue_growth < 0 and profit_margin < 0", "action": "sell", "reason": "双降预警"},
    {"condition": "default", "action": "neutral", "reason": "需进一步分析"}
  ],
  "created_at": "2026-05-31T00:00:00"
}
