{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialChain v1",
  "description": "执行凭证链数据模型 - 可追溯、防篡改的任务执行报告",
  "type": "object",
  "required": ["chain_id", "version", "entries", "created_at"],
  "properties": {
    "chain_id": {
      "type": "string",
      "description": "凭证链唯一标识 (UUID)"
    },
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "凭证链版本"
    },
    "task_id": {
      "type": "string",
      "description": "关联的任务ID"
    },
    "task_type": {
      "type": "string",
      "description": "任务类型"
    },
    "entries": {
      "type": "array",
      "description": "凭证条目列表，按执行顺序排列",
      "items": {
        "$ref": "#/definitions/CredentialEntry"
      },
      "minItems": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "chain_hash": {
      "type": "string",
      "description": "整条链的SHA-256哈希（防篡改校验）"
    }
  },
  "definitions": {
    "CredentialEntry": {
      "type": "object",
      "required": ["entry_id", "step_index", "action", "input_hash", "output_digest", "timestamp", "signature"],
      "properties": {
        "entry_id": {
          "type": "string",
          "description": "条目唯一标识"
        },
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "description": "执行步骤序号"
        },
        "action": {
          "type": "string",
          "description": "执行的动作名称"
        },
        "input_hash": {
          "type": "string",
          "description": "输入数据的SHA-256哈希"
        },
        "output_digest": {
          "type": "string",
          "description": "输出内容的摘要（前200字符的SHA-256）"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "signature": {
          "type": "string",
          "description": "数字签名（HMAC-SHA256）"
        },
        "prev_hash": {
          "type": "string",
          "description": "前一条目的哈希（链式结构）"
        },
        "metadata": {
          "type": "object",
          "description": "附加元数据（Worker ID、执行耗时等）",
          "properties": {
            "worker_id": { "type": "string" },
            "duration_ms": { "type": "integer" },
            "status": { "type": "string", "enum": ["success", "failed", "skipped"] }
          }
        }
      }
    }
  }
}
