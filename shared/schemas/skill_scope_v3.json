{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillScope v3",
  "description": "技能作用域与互斥锁数据模型",
  "type": "object",
  "required": ["skill_id", "version", "scopes", "lock_mode"],
  "properties": {
    "skill_id": { "type": "string" },
    "version": { "type": "string", "const": "3.0" },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": { "type": "string", "enum": ["file", "database", "memory", "network", "queue"] },
          "path": { "type": "string", "description": "作用域路径/模式" },
          "description": { "type": "string" }
        }
      }
    },
    "lock_mode": { "type": "string", "enum": ["read", "write", "exclusive"] },
    "compatible_with": { "type": "array", "items": { "type": "string" } },
    "conflicts_with": { "type": "array", "items": { "type": "string" } }
  }
}
