{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentState v2",
  "description": "智能体资源与能力状态数据模型",
  "type": "object",
  "required": ["agent_id", "version", "status", "capabilities", "resources", "updated_at"],
  "properties": {
    "agent_id": { "type": "string", "description": "智能体唯一标识" },
    "version": { "type": "string", "const": "2.0" },
    "status": { "type": "string", "enum": ["idle", "busy", "draining", "offline"] },
    "capabilities": {
      "type": "object",
      "description": "能力向量",
      "properties": {
        "roles": { "type": "array", "items": { "type": "string" }, "description": "角色列表: researcher, coder, cleaner, reviewer" },
        "skills": { "type": "array", "items": { "type": "string" }, "description": "技能标签" },
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "specializations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resources": {
      "type": "object",
      "description": "实时资源状态",
      "properties": {
        "cpu_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "memory_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "memory_mb": { "type": "number" },
        "load_avg": { "type": "number" },
        "active_tasks": { "type": "integer", "minimum": 0 },
        "queued_tasks": { "type": "integer", "minimum": 0 }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "ttl_seconds": { "type": "integer", "default": 30 }
  }
}
